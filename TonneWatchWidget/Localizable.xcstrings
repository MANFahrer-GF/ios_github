    },
    "Termine in iCloud, Google oder Outlook eintragen und automatisch aktuell halten." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add dates to iCloud, Google or Outlook and keep them up to date automatically."
          }
        }
      }
    },
    "Termine kommen aus dem Abfuhrkalender des Standorts („%@“)." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dates come from the location's collection calendar (“%@”)."
          }
        }
      }
    },
    "Termine kommen direkt von den Portalen der Entsorger (AWIDO, AbfallPlus, Jumomind, Abfallnavi, Abfall-App). Angaben ohne Gewähr. Katalog mit %lld Entsorgern." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dates come directly from the providers' portals (AWIDO, AbfallPlus, Jumomind, Abfallnavi, Abfall-App). No guarantee. Catalog with %lld providers."
          }
        }
      }
    },
    "Termine kommen direkt von den Portalen der Entsorger: AWIDO, AbfallPlus, Jumomind, Abfallnavi, Abfall-App, C-Trace, Müllmax, Gemos, AWSH, Lobbe, Nerdbridge, Mein-Abfallkalender sowie BSR Berlin, Köln, Leipzig und Region Hannover. Der Katalog kennt %lld Entsorger. Alle Angaben ohne Gewähr, im Zweifel gilt der Abfuhrkalender deines Entsorgers." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dates come straight from the providers’ portals: AWIDO, AbfallPlus, Jumomind, Abfallnavi, Abfall-App, C-Trace, Müllmax, Gemos, AWSH, Lobbe, Nerdbridge, Mein-Abfallkalender plus BSR Berlin, Cologne, Leipzig and Hannover region. The catalog knows %lld providers. No guarantee – if in doubt, your provider’s calendar applies."
          }
        }
      }
    },
    "Termine wurden verschoben" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dates have changed"
          }
        }

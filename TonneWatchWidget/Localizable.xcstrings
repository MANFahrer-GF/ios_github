    "Version %@" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %@"
          }
        }
      }
    },
    "Viele Abfallportale bieten einen Link „Kalender abonnieren“ oder „iCal-Export“. Diesen hier einfügen – die App lädt die Termine dann wöchentlich neu. Alternativ kannst du Termine auch von Hand als Rhythmus anlegen." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Many waste portals offer a “subscribe to calendar” or “iCal export” link. Paste it here – the app reloads the dates weekly. Alternatively, set up a schedule manually."
          }
        }
      }
    },
    "Von Hand anlegen" : {
      "extractionState" : "stale",
      "localizations" : {

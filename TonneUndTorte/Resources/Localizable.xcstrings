    "Erinnerung für %@ ist auf dem Sperrbildschirm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder for %@ is on your Lock Screen."
          }
        }
      }
    },
    "Erinnerungen": {
      "localizations": {

      }
    },
    "Abgewählte Tonnen bleiben gespeichert, aber ohne Erinnerung. Du kannst das jederzeit ändern.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unchecked bins are kept but won't send reminders. You can change this anytime."

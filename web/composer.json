{
    "name": "manfahrer/tonne-und-torte-web",
    "description": "Müll- und Geburtstagskalender als PWA mit Kalender-Abo und Web-Push",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "minishlink/web-push": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "TonneTorte\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
